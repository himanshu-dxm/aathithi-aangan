---
import { property } from '../content/property';
import Brand from './Brand.astro';
import Icon from './Icon.astro';
---

<footer>
  <div class="footer-top section-shell">
    <div class="footer-brand">
      <Brand />
      <p class="footer-tag">Peaceful stays in Ranchi, Jharkhand.</p>
      <p class="footer-addr"><Icon name="pin" size={15} /> {property.landmark}, {property.location}</p>
    </div>

    <nav class="footer-col" aria-label="Footer navigation">
      <p class="footer-title">Explore</p>
      <a href="#the-stay">The stay</a>
      <a href="#gallery">Gallery</a>
      <a href="#amenities">Amenities</a>
      <a href="#location">Location</a>
      <a href="#contact">Contact</a>
    </nav>

    <div class="footer-col">
      <p class="footer-title">Connect</p>
      <a href={`tel:+${property.phoneRaw}`}>{property.phoneDisplay}</a>
      <a href={property.whatsappUrl} target="_blank" rel="noreferrer">WhatsApp</a>
      <a href={property.instagramUrl} target="_blank" rel="noreferrer">{property.instagramHandle}</a>
    </div>
  </div>

  <div class="footer-bottom section-shell">
    <p>© {new Date().getFullYear()} {property.name}</p>
    <p>Made with care in Ranchi</p>
  </div>
</footer>

<style>
  footer {
    padding: 3.2rem 0 1.8rem;
    background: var(--cream);
    border-top: 1px solid var(--line);
  }

  .footer-top {
    display: grid;
    gap: 2.4rem;
    color: var(--moss);
  }

  .footer-tag {
    margin: 1rem 0 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.85;
  }

  .footer-addr {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    opacity: 0.8;
  }

  .footer-addr :global(svg) {
    flex: none;
    color: var(--terracotta);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-title {
    margin: 0 0 0.3rem;
    color: var(--terracotta-dark);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-col a {
    color: var(--moss);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .footer-col a:hover {
    color: var(--terracotta-dark);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 2.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    color: var(--moss);
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0.75;
  }

  @media (min-width: 760px) {
    .footer-top {
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: 3rem;
    }

    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>