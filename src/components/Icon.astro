---
interface Props {
  name: 'arrow' | 'instagram' | 'pin' | 'phone' | 'whatsapp' | 'check';
  size?: number;
  title?: string;
}

const { name, size = 20, title } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
>
  {title && <title>{title}</title>}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'pin' && <><path d="M20 10c0 5.2-8 11-8 11S4 15.2 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'phone' && <path d="M5.2 4.7 8 4.1l1.5 4.7-1.8 1.4a15 15 0 0 0 6.1 6.1l1.4-1.8 4.7 1.5-.6 2.8A2.8 2.8 0 0 1 16.6 21C9.1 20.5 3.5 14.9 3 7.4a2.8 2.8 0 0 1 2.2-2.7Z" />}
  {name === 'check' && <path d="m5 12 4.3 4.3L19 6.7" />}
  {name === 'whatsapp' && <><path d="M20.5 11.5a8.5 8.5 0 0 1-12.7 7.4L3.5 20.5l1.6-4.2A8.5 8.5 0 1 1 20.5 11.5Z" /><path d="M8.4 8.3c.2-.5.4-.5.7-.5h.5c.2 0 .4.1.5.4l.7 1.6c.1.3.1.4 0 .6l-.4.6c.6 1.1 1.5 2 2.6 2.6l.6-.4c.2-.1.3-.1.6 0l1.6.7c.3.1.4.3.4.5v.5c0 .3 0 .5-.5.7-.5.2-1.6.3-3.2-.4-1-.4-2.1-1.2-2.9-2.1-.9-.9-1.7-2-2.1-2.9-.7-1.6-.6-2.7-.4-3.2Z" /></>}
  {name === 'instagram' && <><rect width="16" height="16" x="4" y="4" rx="4" /><circle cx="12" cy="12" r="3.5" /><path d="M17.5 6.5h.01" /></>}
</svg>