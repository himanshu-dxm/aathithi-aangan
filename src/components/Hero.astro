---
import { Image } from 'astro:assets';
import heroImage from '../../images/image-8.avif';
import { property } from '../content/property';
import Icon from './Icon.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-inner section-shell">
    <div class="hero-copy">
      <p class="eyebrow">Ranchi, Jharkhand</p>
      <h1 id="hero-title" class="display-heading">Atithi<br /><em>Aangan</em></h1>
      <p class="hero-tagline">{property.tagline}</p>
      <p class="hero-description">A warm and peaceful one-bedroom stay for families, couples, and unhurried workations.</p>
      <div class="hero-actions">
        <a class="button-primary" href={property.airbnbUrl} target="_blank" rel="noreferrer">Book on Airbnb <Icon name="arrow" size={17} /></a>
        <a class="button-secondary" href="#the-stay">Explore the stay</a>
      </div>
      <a
        class="hero-rating"
        href={property.airbnbUrl}
        target="_blank"
        rel="noreferrer"
        aria-label={`Rated ${property.rating} out of 5 from ${property.reviewsCount} reviews on Airbnb`}
      >
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span class="rating-text"><strong>{property.rating}</strong> · {property.reviewsCount} reviews · {property.reviewsNote}</span>
      </a>
      <p class="location-note"><Icon name="pin" size={16} /> {property.landmark}</p>
    </div>
    <div class="hero-visual">
      <div class="hero-image-frame">
        <Image src={heroImage} alt="Restful bedroom at Atithi Aangan with a plush headboard and warm evening light" loading="eager" />
      </div>
      <p class="image-caption">A place to slow down</p>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    padding: 8.3rem 0 4rem;
    background: linear-gradient(118deg, var(--cream) 0%, var(--cream) 58%, var(--mist) 58%, var(--mist) 100%);
  }

  .hero-inner {
    display: grid;
    align-items: center;
    gap: 2.8rem;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  h1 {
    max-width: 8ch;
    margin: 1rem 0 1.2rem;
    color: var(--moss);
    font-size: clamp(4.25rem, 15vw, 7.9rem);
    line-height: 0.79;
  }

  h1 em {
    color: var(--terracotta);
    font-weight: 500;
  }

  .hero-tagline {
    margin: 0;
    color: var(--moss-deep);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.7rem);
    font-style: italic;
  }

  .hero-description {
    max-width: 28rem;
    margin: 1.1rem 0 1.65rem;
    color: color-mix(in srgb, var(--ink), transparent 15%);
    font-size: 0.96rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.2rem;
    text-decoration: none;
  }

  .hero-rating .stars {
    color: var(--terracotta);
    font-size: 0.95rem;
    letter-spacing: 0.12em;
  }

  .hero-rating .rating-text {
    color: var(--moss-deep);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .hero-rating strong {
    color: var(--moss);
    font-weight: 700;
  }

  .hero-rating:hover .rating-text {
    color: var(--terracotta-dark);
  }

  .location-note {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 1.35rem 0 0;
    color: var(--moss);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .hero-visual {
    position: relative;
  }

  .hero-image-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 0.93;
    border-radius: 12rem 12rem 1rem 1rem;
    box-shadow: 1rem 1.2rem 0 var(--sand);
  }

  .hero-image-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-caption {
    position: absolute;
    right: -0.4rem;
    bottom: -2.1rem;
    margin: 0;
    color: var(--terracotta-dark);
    font-family: var(--font-display);
    font-size: 1.04rem;
    font-style: italic;
    transform: rotate(-5deg);
  }

  @media (min-width: 760px) {
    .hero {
      min-height: 43rem;
      padding: 9.75rem 0 5.2rem;
    }

    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.83fr);
      gap: 4.5rem;
    }

    .hero-visual {
      margin-right: 1.4rem;
    }
  }
</style>