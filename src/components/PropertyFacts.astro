---
import { property } from '../content/property';
---

<section class="facts" aria-label="Stay at a glance">
  <div class="facts-inner section-shell">
    <p class="facts-intro">Everything you need<br />for an <em>easy</em> stay.</p>
    <dl>
      {property.facts.map((fact) => (
        <div>
          <dt>{fact.value}</dt>
          <dd>{fact.label}</dd>
        </div>
      ))}
    </dl>
    <p class="terrace-note">+ Hall & open terrace</p>
  </div>
</section>

<style>
  .facts {
    padding: 2.2rem 0;
    color: var(--cream);
    background: var(--moss);
  }

  .facts-inner {
    display: grid;
    gap: 1.9rem;
  }

  .facts-intro,
  .terrace-note {
    margin: 0;
  }

  .facts-intro {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.15;
  }

  .facts-intro em {
    color: #e9c4a4;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
  }

  dt {
    color: #e9c4a4;
    font-family: var(--font-display);
    font-size: 2.1rem;
    line-height: 0.95;
  }

  dd {
    margin: 0.3rem 0 0;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    opacity: 0.86;
    text-transform: uppercase;
  }

  .terrace-note {
    align-self: end;
    color: #e9c4a4;
    font-size: 0.78rem;
    font-weight: 700;
  }

  @media (min-width: 760px) {
    .facts-inner {
      grid-template-columns: 1.1fr 2fr auto;
      align-items: center;
      gap: 3rem;
    }

    dl {
      gap: 2rem;
    }
  }
</style>