---
interface Props {
  href?: string;
}

const { href = '/' } = Astro.props;
---

<a class="brand" href={href} aria-label="Atithi Aangan home">
  <img src="/brand/atithi-aangan-logo.svg" alt="Atithi Aangan" width="120" height="120" />
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--moss);
    text-decoration: none;
  }

  .brand img {
    width: auto;
    height: 3.4rem;
  }
</style>