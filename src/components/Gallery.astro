---
import { Image } from 'astro:assets';
import diningImage from '../../images/image-5.avif';
import livingImage from '../../images/image-6.avif';
import terraceImage from '../../images/image-7.avif';
---

<section id="gallery" class="gallery" aria-labelledby="gallery-title">
  <div class="section-shell">
    <div class="gallery-heading">
      <p class="eyebrow">A glimpse inside</p>
      <h2 id="gallery-title" class="display-heading">Warm corners.<br /><em>Open moments.</em></h2>
    </div>
    <div class="gallery-grid">
      <figure class="gallery-large">
        <Image src={livingImage} alt="Warm and inviting living area with cosy sofa seating" />
      </figure>
      <figure class="gallery-tall">
        <Image src={terraceImage} alt="Open terrace seating with a view of the green surroundings" />
      </figure>
      <figure class="gallery-wide">
        <Image src={diningImage} alt="Dining table and the light-filled shared space" />
      </figure>
    </div>
  </div>
</section>

<style>
  .gallery {
    isolation: isolate;
    overflow: clip;
    padding: 5.75rem 0;
    background: var(--mist);
  }

  .gallery-heading {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2.3rem;
  }

  .gallery-heading .eyebrow {
    color: var(--terracotta-dark);
  }

  h2 {
    margin: 0;
    color: var(--moss);
    font-size: clamp(2.55rem, 6vw, 4.4rem);
    line-height: 0.97;
  }

  h2 em {
    color: var(--terracotta);
    font-weight: 500;
  }

  .gallery-grid {
    position: relative;
    z-index: 0;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 0.8rem;
  }

  figure {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: var(--sand);
  }

  figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  figure:hover :global(img) {
    transform: scale(1.035);
  }

  .gallery-large {
    grid-row: span 2;
    aspect-ratio: 0.84;
    border-radius: 7rem 0.9rem 0.9rem;
  }

  .gallery-tall {
    aspect-ratio: 1 / 1.05;
    border-radius: 0.9rem 4.7rem 0.9rem 0.9rem;
  }

  .gallery-wide {
    aspect-ratio: 1.35 / 1;
    border-radius: 0.9rem;
  }

  @media (min-width: 760px) {
    .gallery-heading {
      flex-direction: row;
      align-items: end;
      justify-content: space-between;
      margin-bottom: 3.5rem;
    }

    .gallery-grid {
      grid-template-columns: 1.06fr 0.9fr 1.04fr;
      grid-template-rows: 14rem 14rem;
      gap: 1rem;
    }

    .gallery-large {
      grid-row: span 2;
      aspect-ratio: auto;
    }

    .gallery-tall {
      grid-row: span 2;
      aspect-ratio: auto;
    }

    .gallery-wide {
      align-self: center;
      aspect-ratio: 1 / 1;
      border-radius: 0.9rem 5rem 0.9rem 0.9rem;
    }
  }
</style>