---
import { Image } from 'astro:assets';
import livingImage from '../../images/image-5.avif';
import bedroomImage from '../../images/image-8.avif';
import coffeeImage from '../../images/image-6.avif';
import terraceImage from '../../images/image-7.avif';

const items = [
  { src: livingImage, area: 'a', label: 'The bedroom', alt: 'Restful bedroom with a plush headboard and soft evening light' },
  { src: bedroomImage, area: 'b', label: 'The living room', alt: 'Warm and inviting living area with a cosy sofa' },
  { src: coffeeImage, area: 'c', label: 'Coffee corner', alt: 'Coffee corner with floating shelves and a mini-fridge' },
  { src: terraceImage, area: 'd', label: 'Terrace at sunset', alt: 'Open terrace seating with a view of the sunset over the trees' },
];
---

<section id="gallery" class="gallery" aria-labelledby="gallery-title">
  <div class="section-shell">
    <div class="gallery-heading">
      <p class="eyebrow">A glimpse inside</p>
      <h2 id="gallery-title" class="display-heading">Warm corners.<br /><em>Open moments.</em></h2>
    </div>
    <div class="gallery-grid" id="gallery-grid">
      {items.map((item, index) => (
        <button
          type="button"
          class={`gallery-item gallery-${item.area}`}
          data-index={index}
          aria-label={`View photo: ${item.alt}`}
        >
          <Image src={item.src} alt={item.alt} />
          <span class="gallery-caption">{item.label}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close photo viewer">&times;</button>
    <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous photo">&#8249;</button>
    <figure class="lightbox-figure">
      <img id="lightbox-img" src="" alt="" />
      <figcaption id="lightbox-caption"></figcaption>
    </figure>
    <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next photo">&#8250;</button>
  </div>
</section>

<script is:inline>
  (() => {
    const grid = document.getElementById('gallery-grid');
    const lightbox = document.getElementById('lightbox');
    const lbImg = document.getElementById('lightbox-img');
    const lbCaption = document.getElementById('lightbox-caption');
    const btnClose = document.getElementById('lightbox-close');
    const btnPrev = document.getElementById('lightbox-prev');
    const btnNext = document.getElementById('lightbox-next');
    if (!grid || !lightbox || !lbImg) return;

    const buttons = Array.from(grid.querySelectorAll('.gallery-item'));
    let current = 0;
    let lastFocused = null;

    const show = (index) => {
      current = (index + buttons.length) % buttons.length;
      const img = buttons[current].querySelector('img');
      if (!img) return;
      lbImg.src = img.currentSrc || img.src;
      lbImg.alt = img.alt;
      lbCaption.textContent = img.alt;
    };

    const open = (index) => {
      lastFocused = document.activeElement;
      show(index);
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      btnClose.focus();
    };

    const close = () => {
      lightbox.hidden = true;
      document.body.style.overflow = '';
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    };

    buttons.forEach((btn, index) => btn.addEventListener('click', () => open(index)));
    btnClose.addEventListener('click', close);
    btnPrev.addEventListener('click', () => show(current - 1));
    btnNext.addEventListener('click', () => show(current + 1));
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) close();
    });
    document.addEventListener('keydown', (event) => {
      if (lightbox.hidden) return;
      if (event.key === 'Escape') close();
      else if (event.key === 'ArrowLeft') show(current - 1);
      else if (event.key === 'ArrowRight') show(current + 1);
    });
  })();
</script>

<style>
  .gallery {
    isolation: isolate;
    overflow: clip;
    padding: 5.75rem 0;
    background: var(--mist);
  }

  .gallery-heading {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2.3rem;
  }

  .gallery-heading .eyebrow {
    color: var(--terracotta-dark);
  }

  h2 {
    margin: 0;
    color: var(--moss);
    font-size: clamp(2.55rem, 6vw, 4.4rem);
    line-height: 0.97;
  }

  h2 em {
    color: var(--terracotta);
    font-weight: 500;
  }

  .gallery-grid {
    position: relative;
    z-index: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 11rem;
    grid-template-areas:
      "a a"
      "b c"
      "d d";
    gap: 0.8rem;
  }

  .gallery-item {
    position: relative;
    min-width: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: var(--sand);
    border: none;
    border-radius: 0.9rem;
    cursor: zoom-in;
  }

  .gallery-item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .gallery-item:hover :global(img) {
    transform: scale(1.035);
  }

  .gallery-item::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    z-index: 0;
    height: 45%;
    background: linear-gradient(to top, rgba(26, 33, 27, 0.6), transparent);
    pointer-events: none;
  }

  .gallery-caption {
    position: absolute;
    z-index: 1;
    right: 0.9rem;
    bottom: 0.85rem;
    left: 0.9rem;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-style: italic;
    text-align: left;
    text-shadow: 0 1px 10px rgba(26, 33, 27, 0.65);
    pointer-events: none;
  }

  .gallery-a {
    grid-area: a;
    border-radius: 4.5rem 0.9rem 0.9rem;
  }

  .gallery-b {
    grid-area: b;
    border-radius: 0.9rem 0.9rem 0.9rem 3rem;
  }

  .gallery-c {
    grid-area: c;
    border-radius: 0.9rem 3rem 0.9rem 0.9rem;
  }

  .gallery-d {
    grid-area: d;
    border-radius: 0.9rem 0.9rem 4.5rem 0.9rem;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: clamp(1rem, 4vw, 3rem);
    background: rgba(26, 33, 27, 0.9);
    backdrop-filter: blur(4px);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    max-width: min(100%, 60rem);
    margin: 0;
  }

  .lightbox-figure img {
    max-width: 100%;
    max-height: 78vh;
    border-radius: 0.8rem;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .lightbox-figure figcaption {
    color: var(--cream);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-align: center;
  }

  .lightbox-close {
    position: absolute;
    top: clamp(0.75rem, 3vw, 1.5rem);
    right: clamp(0.75rem, 3vw, 1.5rem);
    width: 2.8rem;
    height: 2.8rem;
    color: var(--cream);
    background: rgba(247, 242, 232, 0.12);
    border: 1px solid rgba(247, 242, 232, 0.3);
    border-radius: 50%;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 180ms ease;
  }

  .lightbox-nav {
    flex: none;
    width: 2.8rem;
    height: 2.8rem;
    color: var(--cream);
    background: rgba(247, 242, 232, 0.12);
    border: 1px solid rgba(247, 242, 232, 0.3);
    border-radius: 50%;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 180ms ease;
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    background: rgba(247, 242, 232, 0.25);
  }

  @media (min-width: 760px) {
    .gallery-heading {
      flex-direction: row;
      align-items: end;
      justify-content: space-between;
      margin-bottom: 3.5rem;
    }

    .gallery-grid {
      grid-template-columns: 1.15fr 1fr 1fr;
      grid-auto-rows: 14rem;
      grid-template-areas:
        "a b c"
        "a d d";
      gap: 1rem;
    }
  }
</style>